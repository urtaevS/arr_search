PORT=3000

# Jackett
JACKETT_URL=http://jackett:9118
JACKETT_API_KEY=your_jackett_api_key_here

# Prowlarr (опционально)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# Список индексаторов Jackett для предварительного выбора.
# Если не указан — будет попытка получить из Jackett API.
JACKETT_INDEXERS=anidub,anilibria,bigfangroup,kinozal,limetorrents,lostfilm,megapeer,metaltracker,noname-club,rustorka,rutor,rutracker,rutracker-ru,tapochek

# TorrentMonitor (отправка раздач в отслеживание)
TM_URL=http://ваш-адрес-tm:порт
TM_API_KEY=your_torrentmonitor_api_key_here

# Папка для сохранения .torrent (watch-папка торрент-качалки, монтируется в Docker).
# Локально по умолчанию: ./data/torrents
# В Docker (docker-compose) путь задаётся через environment: TORRENT_WATCH_DIR=/app/torrents
# TORRENT_WATCH_DIR=/app/torrents
